<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>后室·特遣队 | 深渊影袭</title>
    <style>
        body { margin: 0; overflow: hidden; font-family: 'Courier New', monospace; background: #000; touch-action: none; }
        .svg-icon { width: 20px; height: 20px; display: inline-block; vertical-align: middle; filter: drop-shadow(0 0 2px #000); }
        #ui { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; color: #ffe6b3; text-shadow: 0 0 4px #000; font-weight: bold; }
        .stats-panel { position: absolute; top: 20px; left: 20px; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); padding: 10px 18px; border-radius: 12px; border-left: 3px solid #ffcc77; display: flex; gap: 20px; flex-wrap: wrap; font-size: 14px; }
        .stat-item { display: flex; align-items: center; gap: 6px; }
        .weapon-panel { position: absolute; bottom: 30px; left: 20px; background: rgba(0,0,0,0.7); backdrop-filter: blur(12px); border-radius: 40px; padding: 8px 20px; display: flex; gap: 20px; border: 1px solid #ffaa66; }
        .weapon-slot { padding: 6px 16px; border-radius: 30px; background: #2a2a2a; display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer; pointer-events: auto; transition: all 0.1s; }
        .weapon-slot.active { background: #ffaa33; color: #000; box-shadow: 0 0 10px #ffaa66; }
        .ammo-panel { position: absolute; bottom: 30px; right: 30px; background: rgba(0,0,0,0.7); backdrop-filter: blur(12px); padding: 10px 24px; border-radius: 40px; font-size: 24px; font-weight: bold; border: 1px solid #ffaa66; display: flex; align-items: center; gap: 10px; }
        .distance-panel { position: absolute; top: 20px; right: 20px; background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); padding: 8px 16px; border-radius: 20px; font-size: 13px; display: flex; align-items: center; gap: 8px; }
        .crosshair { position: absolute; top: 50%; left: 50%; width: 4px; height: 4px; background: white; border-radius: 50%; transform: translate(-50%, -50%); box-shadow: 0 0 0 2px rgba(0,0,0,0.5), 0 0 0 4px rgba(255,200,100,0.5); pointer-events: none; z-index: 20; transition: transform 0.05s ease-out; }
        .joystick-area { position: absolute; bottom: 30px; left: 30px; width: 140px; height: 140px; pointer-events: auto; z-index: 30; }
        .joystick-base { width: 100%; height: 100%; border-radius: 50%; background: rgba(30,30,30,0.6); border: 2px solid rgba(255,200,100,0.7); position: relative; backdrop-filter: blur(4px); }
        .joystick-thumb { width: 60px; height: 60px; border-radius: 50%; background: rgba(255,200,100,0.8); position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); pointer-events: none; box-shadow: 0 0 10px rgba(255,200,100,0.5); }
        .action-btn, .melee-btn, .rescue-btn { position: absolute; pointer-events: auto; display: flex; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(8px); z-index: 30; border-radius: 50%; transition: all 0.1s; }
        .action-btn { bottom: 40px; right: 40px; width: 75px; height: 75px; background: rgba(180,50,50,0.85); border: 2px solid #ffaa66; box-shadow: 0 0 15px rgba(255,80,40,0.6); }
        .melee-btn { bottom: 140px; right: 40px; width: 60px; height: 60px; background: rgba(80,80,80,0.85); border: 2px solid #ccaa77; }
        .rescue-btn { bottom: 230px; right: 40px; width: 60px; height: 60px; background: rgba(50,150,200,0.85); border: 2px solid #88ccff; display: none; }
        .interact-hint { position: absolute; bottom: 180px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); padding: 10px 24px; border-radius: 40px; color: #ffdd99; font-size: 14px; border: 1px solid #ffcc77; pointer-events: none; white-space: nowrap; font-weight: bold; }
        .player-list { position: absolute; top: 80px; left: 20px; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); padding: 8px 14px; border-radius: 12px; font-size: 12px; max-width: 220px; pointer-events: none; display: flex; align-items: center; gap: 8px; }
        .flashlight-toggle { position: absolute; top: 20px; right: 120px; background: rgba(0,0,0,0.5); backdrop-filter: blur(8px); padding: 6px 12px; border-radius: 30px; font-size: 12px; pointer-events: auto; cursor: pointer; z-index: 30; display: flex; align-items: center; gap: 6px; }
        #auth-panel { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: rgba(0,0,0,0.95); backdrop-filter: blur(20px); padding: 35px; border-radius: 24px; border: 1px solid #ffcc77; text-align: center; z-index: 100; width: 300px; pointer-events: auto; box-shadow: 0 0 40px rgba(0,0,0,0.8); }
        #auth-panel input { display: block; width: 100%; margin: 12px 0; padding: 12px; background: #222; border: 1px solid #ffcc77; color: #ffebc2; border-radius: 12px; font-size: 14px; }
        #auth-panel button { background: #ffaa33; border: none; padding: 10px 20px; margin: 8px; width: 110px; border-radius: 40px; cursor: pointer; font-weight: bold; font-size: 14px; transition: 0.1s; }
        #auth-panel button:hover { background: #ffcc66; transform: scale(1.02); }
        .damage-flash { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(180,0,0,0); pointer-events: none; z-index: 15; transition: background 0.08s; }
        #loading { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #000; z-index: 200; display: flex; align-items: center; justify-content: center; color: #ffcc77; font-size: 24px; letter-spacing: 4px; backdrop-filter: blur(4px); }
        @media (max-width: 700px) {
            .stats-panel { font-size: 11px; top: 10px; left: 10px; gap: 12px; padding: 6px 12px; }
            .weapon-panel { font-size: 12px; bottom: 20px; left: 10px; gap: 10px; padding: 6px 12px; }
            .ammo-panel { font-size: 18px; padding: 6px 14px; bottom: 20px; right: 20px; }
            .joystick-area { width: 110px; height: 110px; bottom: 20px; left: 20px; }
            .action-btn { width: 65px; height: 65px; bottom: 25px; right: 25px; }
            .melee-btn { width: 50px; height: 50px; bottom: 105px; right: 32px; }
            .rescue-btn { width: 50px; height: 50px; bottom: 175px; right: 32px; }
        }
    </style>
</head>
<body>
<div id="loading">加载后室·特遣队...</div>
<div id="auth-panel" style="display: none;">
    <h3><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffcc77" stroke-width="1.5"><path d="M12 2v4M12 18v4M4 12H2M6 12H4M20 12h-2M22 12h-2M18 6l2-2M16 8l2-2M6 18l-2 2M8 16l-2 2"/><circle cx="12" cy="12" r="3"/></svg> 后室·特遣队</h3>
    <input type="text" id="auth-email" placeholder="邮箱" autocomplete="off">
    <input type="password" id="auth-password" placeholder="密码">
    <button id="login-btn">登录</button>
    <button id="register-btn">注册</button>
    <div id="auth-msg" style="color: #ff8888; margin-top: 12px; font-size: 12px;"></div>
</div>
<div id="ui" style="display: none;">
    <div class="stats-panel">
        <div class="stat-item"><svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="#ff6666"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg><span id="health-val">100</span>%</div>
        <div class="stat-item"><svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="#88ccff"><path d="M12 3v1M12 20v1M3 12H2M22 12h-1M5.64 5.64l.7.7M17.66 17.66l.7.7M5.64 18.36l.7-.7M17.66 6.34l.7-.7"/><circle cx="12" cy="12" r="4"/><path d="M12 8v4l2 2"/></svg><span id="sanity-val">100</span></div>
        <div class="stat-item"><svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="#66ff66"><path d="M12 2v2M12 20v2M4 12H2M22 12h-2M6 6l2 2M16 16l2 2M6 18l2-2M16 8l2-2"/><path d="M12 6v6l3 2"/></svg><span id="stamina-val">100</span></div>
        <div class="stat-item"><svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="#88ff88"><path d="M2 12h20M12 2v20"/><circle cx="12" cy="12" r="3"/></svg><span id="water-val">0</span></div>
    </div>
    <div class="weapon-panel">
        <div class="weapon-slot" id="weap-pistol"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="9" width="18" height="10" rx="1"/><line x1="6" y1="14" x2="18" y2="14"/></svg>M1911</div>
        <div class="weapon-slot" id="weap-smg"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="2" y="10" width="20" height="8" rx="1"/><path d="M7 10V8a2 2 0 012-2h6a2 2 0 012 2v3"/></svg>勇士</div>
        <div class="weapon-slot" id="weap-mg3"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="10" width="18" height="8" rx="1"/><path d="M8 10V7a2 2 0 012-2h4a2 2 0 012 2v3"/><circle cx="12" cy="14" r="1"/></svg>MG3</div>
    </div>
    <div class="ammo-panel"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffcc77"><path d="M12 2v4M12 18v4M4 12H2M6 12H4M20 12h-2M22 12h-2M18 6l2-2M16 8l2-2M6 18l-2 2M8 16l-2 2"/><circle cx="12" cy="12" r="3"/></svg><span id="ammo-val">50</span>/<span id="ammo-max">200</span></div>
    <div class="distance-panel"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ffcc77"><circle cx="12" cy="12" r="10"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/></svg><span id="distance-val">0</span>m <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#88ff88"><path d="M3 12h3l2-3 2 3 2-3 2 3 2-3 2 3 2-3 1 3"/><path d="M3 18h18"/></svg><span id="exit-dist">15km</span></div>
    <div class="player-list"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#88ccff"><circle cx="12" cy="8" r="4"/><path d="M5 20v-2a7 7 0 0114 0v2"/></svg><span id="player-count">1</span></div>
    <div class="crosshair"></div>
    <div class="flashlight-toggle" id="flashlight-btn"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.64 5.64l2.12 2.12M16.24 16.24l2.12 2.12M16.24 7.76l2.12-2.12M5.64 18.36l2.12-2.12"/><circle cx="12" cy="12" r="3"/></svg>手电 OFF</div>
    <div class="interact-hint" id="interact-hint" style="display: none;">🔘 靠近补给 / 出口门</div>
</div>
<div class="joystick-area" id="joystick-area"><div class="joystick-base"><div class="joystick-thumb" id="joystick-thumb"></div></div></div>
<div class="action-btn" id="shoot-btn"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white"><circle cx="12" cy="12" r="3"/><path d="M12 4v2M12 18v2M4 12h2M18 12h2"/><path d="M7 7l2 2M15 15l2 2M15 9l2-2M7 17l2-2"/></svg></div>
<div class="melee-btn" id="melee-btn"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white"><path d="M8 21L16 5M8 21L3 16M8 21L12 17M16 5L12 9M16 5L20 9"/></svg></div>
<div class="rescue-btn" id="rescue-btn"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white"><path d="M2 12h20M12 2v20"/><circle cx="12" cy="12" r="3"/></svg></div>
<div class="damage-flash" id="damage-flash"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://unpkg.com/@supabase/supabase-js@2"></script>

<script>
    // ==================== Supabase 配置（已使用您提供的凭据） ====================
    const SUPABASE_URL = "https://mvgljtcfxmvtgbshpsgd.supabase.co";
    const SUPABASE_ANON_KEY = "sb_publishable_t6M6Fbds5o4q3sCC0aIZZQ_LXT0BGBF";
    const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    // ==================== 游戏状态 ====================
    let currentUser = null;
    let players = new Map();
    let monsters = [];
    let supplyRooms = [];
    let exitDoors = [];
    let currentDistance = 0;
    let lastPosition = { x: 0, z: 0 };
    let health = 100;
    let sanity = 100;
    let stamina = 100;
    let almondWater = 0;
    let isDead = false;
    let deathPosition = null;
    
    // 武器系统 - 默认勇士冲锋枪 50/200
    let currentWeapon = 1;
    let ammo = { pistol: 16, smg: 50, mg3: 0 };
    let maxAmmo = { pistol: 200, smg: 200, mg3: 200 };
    let weaponDamageMonster = { pistol: 1, smg: 1, mg3: 1 };
    let weaponFireRate = { pistol: 0.35, smg: 0.12, mg3: 0.08 };
    let lastShootTime = 0;
    
    const PLAYER_SPEED = 8.61;
    const MONSTER_SPEED = 8.33;
    
    let scene, camera, renderer;
    let clock = new THREE.Clock();
    let raycaster = new THREE.Raycaster();
    let keyState = { w: false, s: false, a: false, d: false, e: false };
    let isPointerLock = false;
    let joystickActive = false, joystickVector = { x: 0, z: 0 };
    let cameraRotation = { yaw: 0, pitch: 0 };
    let flashlightLight, ambientLight, dirLight;
    let weaponModel = null;
    let postFX;
    
    // UI 元素
    const healthSpan = document.getElementById('health-val');
    const sanitySpan = document.getElementById('sanity-val');
    const staminaSpan = document.getElementById('stamina-val');
    const waterSpan = document.getElementById('water-val');
    const distanceSpan = document.getElementById('distance-val');
    const exitDistSpan = document.getElementById('exit-dist');
    const ammoValSpan = document.getElementById('ammo-val');
    const ammoMaxSpan = document.getElementById('ammo-max');
    const playerCountSpan = document.getElementById('player-count');
    const interactHint = document.getElementById('interact-hint');
    const rescueBtn = document.getElementById('rescue-btn');
    
    function updateUI() {
        healthSpan.innerText = Math.floor(health);
        sanitySpan.innerText = Math.floor(sanity);
        staminaSpan.innerText = Math.floor(stamina);
        waterSpan.innerText = almondWater;
        distanceSpan.innerText = Math.floor(currentDistance);
        let nearestExitDist = 15000;
        for (let door of exitDoors) {
            let d = Math.hypot(camera.position.x - door.pos.x, camera.position.z - door.pos.z);
            if (d < nearestExitDist) nearestExitDist = d;
        }
        exitDistSpan.innerText = nearestExitDist > 1000 ? `${(nearestExitDist/1000).toFixed(1)}km` : `${Math.floor(nearestExitDist)}m`;
        let currentAmmo = currentWeapon === 0 ? ammo.pistol : (currentWeapon === 1 ? ammo.smg : ammo.mg3);
        let currentMax = currentWeapon === 0 ? maxAmmo.pistol : (currentWeapon === 1 ? maxAmmo.smg : maxAmmo.mg3);
        ammoValSpan.innerText = currentAmmo;
        ammoMaxSpan.innerText = currentMax;
        document.getElementById('weap-pistol').classList.toggle('active', currentWeapon === 0);
        document.getElementById('weap-smg').classList.toggle('active', currentWeapon === 1);
        document.getElementById('weap-mg3').classList.toggle('active', currentWeapon === 2);
    }
    
    function takeDamage(amount) {
        if (isDead) return;
        health = Math.max(0, health - amount);
        sanity = Math.max(0, sanity - amount * 0.4);
        updateUI();
        const flash = document.getElementById('damage-flash');
        flash.style.backgroundColor = 'rgba(180,0,0,0.7)';
        setTimeout(() => flash.style.backgroundColor = 'rgba(180,0,0,0)', 120);
        if (health <= 0) {
            isDead = true;
            deathPosition = { x: camera.position.x, z: camera.position.z };
            if (currentUser) supabase.from('players').update({ is_dead: true, death_x: deathPosition.x, death_z: deathPosition.z }).eq('user_id', currentUser.id);
            interactHint.style.display = 'block';
            interactHint.innerText = '你已死亡！等待队友使用杏仁水复活你';
            setTimeout(() => { if(isDead) interactHint.style.display = 'none'; }, 5000);
        }
    }
    
    function reviveByAlmondWater() {
        if (!isDead) return;
        if (almondWater <= 0) return;
        almondWater--;
        health = 50; sanity = 60; stamina = 80;
        isDead = false;
        camera.position.set(deathPosition.x, 1.65, deathPosition.z);
        lastPosition = { x: deathPosition.x, z: deathPosition.z };
        if (currentUser) supabase.from('players').update({ is_dead: false }).eq('user_id', currentUser.id);
        updateUI();
        interactHint.style.display = 'none';
    }
    
    function shoot() {
        if (isDead) return;
        let currentAmmo = currentWeapon === 0 ? ammo.pistol : (currentWeapon === 1 ? ammo.smg : ammo.mg3);
        if (currentAmmo <= 0) return;
        let now = Date.now() / 1000;
        let rate = weaponFireRate[currentWeapon === 0 ? 'pistol' : (currentWeapon === 1 ? 'smg' : 'mg3')];
        if (now - lastShootTime < rate) return;
        lastShootTime = now;
        
        if (currentWeapon === 0) ammo.pistol--;
        else if (currentWeapon === 1) ammo.smg--;
        else ammo.mg3--;
        updateUI();
        
        cameraRotation.pitch += 0.045;
        if (weaponModel) {
            weaponModel.position.y = -0.12;
            weaponModel.rotation.x = 0.18;
            setTimeout(() => { if(weaponModel) { weaponModel.position.y = 0; weaponModel.rotation.x = 0; } }, 100);
        }
        const muzzleFlash = new THREE.PointLight(0xffaa66, 1.8, 6);
        muzzleFlash.position.set(0.45, -0.1, 0.65);
        if (weaponModel) weaponModel.add(muzzleFlash);
        setTimeout(() => { if(weaponModel) weaponModel.remove(muzzleFlash); }, 80);
        
        raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
        let dmg = weaponDamageMonster[currentWeapon === 0 ? 'pistol' : (currentWeapon === 1 ? 'smg' : 'mg3')];
        for (let i = 0; i < monsters.length; i++) {
            if (raycaster.intersectObject(monsters[i].mesh, true).length > 0) {
                monsters[i].health -= dmg;
                if (monsters[i].health <= 0) {
                    scene.remove(monsters[i].mesh);
                    monsters.splice(i,1);
                }
                break;
            }
        }
    }
    
    function meleeAttack() {
        if (isDead) return;
        raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
        for (let i = 0; i < monsters.length; i++) {
            if (raycaster.intersectObject(monsters[i].mesh, true).length > 0 && raycaster.intersectObject(monsters[i].mesh, true)[0].distance < 2) {
                monsters[i].health -= 5;
                if (monsters[i].health <= 0) { scene.remove(monsters[i].mesh); monsters.splice(i,1); }
                break;
            }
        }
    }
    
    // ==================== 武器模型 ====================
    function createSMG() {
        const group = new THREE.Group();
        const body = new THREE.Mesh(new THREE.BoxGeometry(0.24, 0.15, 0.58), new THREE.MeshStandardMaterial({ color: 0x2a2a2a, metalness: 0.75 }));
        body.position.set(0, 0, 0.05); group.add(body);
        const mag = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.24, 0.13), new THREE.MeshStandardMaterial({ color: 0x553322 }));
        mag.position.set(0, -0.18, 0); group.add(mag);
        const barrel = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.055, 0.48, 12), new THREE.MeshStandardMaterial({ color: 0x111111, metalness: 0.95 }));
        barrel.rotation.z = Math.PI/2; barrel.position.set(0, 0.03, 0.48); group.add(barrel);
        const stock = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.1, 0.2), new THREE.MeshStandardMaterial({ color: 0x443322 }));
        stock.position.set(0, 0, -0.38); group.add(stock);
        return group;
    }
    function createPistol() {
        const group = new THREE.Group();
        const slide = new THREE.Mesh(new THREE.BoxGeometry(0.19, 0.13, 0.48), new THREE.MeshStandardMaterial({ color: 0x333333, metalness: 0.9 }));
        slide.position.set(0, 0, 0.1); group.add(slide);
        const grip = new THREE.Mesh(new THREE.BoxGeometry(0.14, 0.22, 0.3), new THREE.MeshStandardMaterial({ color: 0x5a3a2a }));
        grip.position.set(0, -0.13, -0.1); group.add(grip);
        const barrel = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.055, 0.38, 12), new THREE.MeshStandardMaterial({ color: 0x222222, metalness: 0.95 }));
        barrel.rotation.z = Math.PI/2; barrel.position.set(0, 0.02, 0.38); group.add(barrel);
        return group;
    }
    function createMG3() {
        const group = new THREE.Group();
        const body = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.18, 0.7), new THREE.MeshStandardMaterial({ color: 0x2a2a2a, metalness: 0.8 }));
        body.position.set(0, 0, 0.05); group.add(body);
        const barrel = new THREE.Mesh(new THREE.CylinderGeometry(0.075, 0.075, 0.6, 12), new THREE.MeshStandardMaterial({ color: 0x111111, metalness: 0.95 }));
        barrel.rotation.z = Math.PI/2; barrel.position.set(0, 0.05, 0.6); group.add(barrel);
        const bipod = new THREE.Mesh(new THREE.BoxGeometry(0.25, 0.06, 0.35), new THREE.MeshStandardMaterial({ color: 0x553322 }));
        bipod.position.set(0, -0.14, 0.25); group.add(bipod);
        return group;
    }
    function switchWeapon(idx) {
        if (idx === currentWeapon) return;
        currentWeapon = idx;
        if (weaponModel) scene.remove(weaponModel);
        if (currentWeapon === 0) weaponModel = createPistol();
        else if (currentWeapon === 1) weaponModel = createSMG();
        else weaponModel = createMG3();
        weaponModel.position.set(0.38, -0.27, -0.48);
        weaponModel.rotation.x = 0.12;
        weaponModel.rotation.z = -0.12;
        camera.add(weaponModel);
        updateUI();
    }
    
    // ==================== 玩家模型（特战士兵） ====================
    function createPlayerModel(name, isLocal = false) {
        const group = new THREE.Group();
        const bodyMat = new THREE.MeshStandardMaterial({ color: 0x5a6e3c, roughness: 0.5 });
        const body = new THREE.Mesh(new THREE.CylinderGeometry(0.4, 0.4, 1.35, 12), bodyMat);
