    function checkAndSpawn() {
        const walked = currentDistance;
        const supplyStep = Math.floor(walked / 1000);
        const lastSupply = Math.floor((walked - 0.5) / 1000);
        if (supplyStep > lastSupply) {
            const angle = Math.random() * Math.PI * 2;
            const rad = 30;
            const pos = new THREE.Vector3(camera.position.x + Math.cos(angle)*rad, 0, camera.position.z + Math.sin(angle)*rad);
            spawnSupplyStation(pos);
        }
        const exitRing = Math.floor(walked / 15000);
        if (exitDoors.length < exitRing + 1) spawnExitDoor(new THREE.Vector3(0,0,0));
    }
    function handleInteractions() {
        for (let i=0; i<supplyRooms.length; i++) {
            const s = supplyRooms[i];
            if (s.used) continue;
            if (camera.position.distanceTo(s.pos) < 3) {
                interactHint.style.display = 'block';
                interactHint.innerText = '📦 补给站 → 按 E 获取弹药 + 杏仁水';
                if (keyState.e) {
                    s.used = true;
                    scene.remove(s.mesh);
                    ammo.pistol = Math.min(maxAmmo.pistol, ammo.pistol + 30);
                    ammo.smg = Math.min(maxAmmo.smg, ammo.smg + 30);
                    ammo.mg3 = Math.min(maxAmmo.mg3, ammo.mg3 + 100);
                    almondWater++;
                    health = Math.min(100, health + 20);
                    sanity = Math.min(100, sanity + 15);
                    updateUI();
                    supplyRooms.splice(i,1);
                    interactHint.style.display = 'none';
                }
                return;
            }
        }
        for (let door of exitDoors) {
            if (camera.position.distanceTo(door.pos) < 3) {
                interactHint.style.display = 'block';
                interactHint.innerText = '🚪 出口门 → 按 E 逃离后室';
                if (keyState.e) { alert("成功逃离后室！刷新页面继续游戏。"); window.location.reload(); }
                return;
            }
        }
        interactHint.style.display = 'none';
    }
    
    function updateStats(delta) {
        let moving = (keyState.w||keyState.s||keyState.a||keyState.d||joystickActive);
        if (moving && stamina > 0) stamina = Math.max(0, stamina - delta * 14);
        else if (!moving && stamina < 100) stamina = Math.min(100, stamina + delta * 9);
        let closest = 999;
        for (let m of monsters) closest = Math.min(closest, camera.position.distanceTo(m.mesh.position));
        if (closest < 18) sanity = Math.max(0, sanity - delta * 8 * (1 - closest/18));
        else if (sanity < 100) sanity = Math.min(100, sanity + delta * 2.5);
        updateUI();
    }
    
    function updateMovement(delta) {
        if (isDead) return;
        let moveX=0, moveZ=0;
        if (keyState.w) moveZ-=1; if (keyState.s) moveZ+=1; if (keyState.a) moveX-=1; if (keyState.d) moveX+=1;
        if (joystickActive) { moveX = joystickVector.x; moveZ = joystickVector.z; }
        if (moveX!==0 || moveZ!==0) {
            let speed = PLAYER_SPEED;
            if (stamina < 20) speed = PLAYER_SPEED * 0.6;
            const forward = new THREE.Vector3(-Math.sin(cameraRotation.yaw),0,-Math.cos(cameraRotation.yaw));
            const right = new THREE.Vector3(Math.cos(cameraRotation.yaw),0,-Math.sin(cameraRotation.yaw));
            let vel = new THREE.Vector3(0,0,0);
            vel.addScaledVector(forward, moveZ);
            vel.addScaledVector(right, moveX);
            vel.normalize();
            camera.position.x += vel.x * speed * delta;
            camera.position.z += vel.z * speed * delta;
            const dx = camera.position.x - lastPosition.x;
            const dz = camera.position.z - lastPosition.z;
            currentDistance += Math.sqrt(dx*dx + dz*dz);
            lastPosition.x = camera.position.x;
            lastPosition.z = camera.position.z;
            updateUI();
            checkAndSpawn();
        }
        camera.rotation.order = 'YXZ';
        camera.rotation.y = cameraRotation.yaw;
        camera.rotation.x = cameraRotation.pitch;
        cameraRotation.pitch = Math.max(-0.75, Math.min(0.65, cameraRotation.pitch));
    }
    
    function spawnMonstersNearby() {
        if (monsters.length < 7 && Math.random() < 0.02) {
            const angle = Math.random() * Math.PI * 2;
            const dist = 25 + Math.random() * 20;
            const pos = new THREE.Vector3(camera.position.x + Math.cos(angle)*dist, 0, camera.position.z + Math.sin(angle)*dist);
            const r = Math.random();
            if (r < 0.3) monsters.push(new SmilerEntity(pos));
            else if (r < 0.55) monsters.push(new MimicEntity(pos));
            else if (r < 0.75) monsters.push(new DollEntity(pos));
            else monsters.push(new ShadowEntity(pos));
        }
    }
    
    async function syncPlayers() {
        if (!currentUser) return;
        await supabase.from('players').upsert({
            user_id: currentUser.id,
            name: currentUser.email.split('@')[0],
            pos_x: camera.position.x, pos_z: camera.position.z, rot_y: cameraRotation.yaw,
            health, sanity, stamina, almond_water: almondWater, is_dead: isDead,
            death_x: deathPosition?.x || 0, death_z: deathPosition?.z || 0, last_seen: new Date()
        });
        const { data } = await supabase.from('players').select('*').neq('user_id', currentUser.id);
        if (data) {
            for (let p of data) {
                if (!players.has(p.user_id)) {
                    const { group } = createPlayerModel(p.name);
                    group.position.set(p.pos_x, 1.65, p.pos_z);
                    scene.add(group);
                    players.set(p.user_id, { mesh: group, isDead: p.is_dead, deathPos: { x: p.death_x, z: p.death_z } });
                } else {
                    const player = players.get(p.user_id);
                    player.mesh.position.set(p.pos_x, 1.65, p.pos_z);
                    player.isDead = p.is_dead;
                    player.deathPos = { x: p.death_x, z: p.death_z };
                }
            }
        }
        playerCountSpan.innerText = players.size + 1;
        let nearbyDead = false;
        for (let [id, p] of players) {
            if (p.isDead && camera.position.distanceTo(new THREE.Vector3(p.deathPos.x, 0, p.deathPos.z)) < 5) nearbyDead = true;
        }
        rescueBtn.style.display = nearbyDead && !isDead && almondWater > 0 ? 'flex' : 'none';
    }
    
    function setupPost() {
        const w = window.innerWidth, h = window.innerHeight;
        const rt = new THREE.WebGLRenderTarget(w, h);
        const pScene = new THREE.Scene();
        const pCamera = new THREE.OrthographicCamera(-1,1,1,-1,0,1);
        const pMat = new THREE.ShaderMaterial({
            uniforms: { tDiffuse: { value: rt.texture }, uTime: { value: 0 } },
            vertexShader: `varying vec2 vUv; void main() { vUv = uv; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }`,
            fragmentShader: `
                uniform sampler2D tDiffuse;
                uniform float uTime;
                varying vec2 vUv;
                float rand(vec2 co) { return fract(sin(dot(co, vec2(12.9898,78.233))) * 43758.5453); }
                void main() {
                    vec2 uv = vUv;
                    vec4 color = texture2D(tDiffuse, uv);
                    float grain = rand(uv + floor(uTime * 30.0)) * 0.09;
                    color.rgb += grain;
                    float scanline = sin(uv.y * 900.0) * 0.025;
                    color.rgb -= scanline;
                    float shift = 0.0015;
                    float r = texture2D(tDiffuse, uv + vec2(shift, 0.0)).r;
                    float b = texture2D(tDiffuse, uv - vec2(shift, 0.0)).b;
                    color.r = mix(color.r, r, 0.25);
                    color.b = mix(color.b, b, 0.25);
                    float vig = 1.0 - length(uv - 0.5) * 0.4;
                    color.rgb *= vig;
                    gl_FragColor = vec4(color.rgb, 1.0);
                }
            `
        });
        const quad = new THREE.Mesh(new THREE.PlaneGeometry(2,2), pMat);
        pScene.add(quad);
        return { renderTarget: rt, scene: pScene, camera: pCamera, material: pMat };
    }
    
    async function initGame() {
        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x1a140f);
        scene.fog = new THREE.FogExp2(0x1a140f, 0.002);
        camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.05, 500);
        camera.position.set(0, 1.65, 0);
        lastPosition = { x:0, z:0 };
        renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        renderer.shadowMap.enabled = true;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.3;
        document.body.appendChild(renderer.domElement);
        
        ambientLight = new THREE.AmbientLight(0x443322, 0.7);
        scene.add(ambientLight);
        dirLight = new THREE.DirectionalLight(0xffdd99, 1.2);
        dirLight.position.set(8,12,5);
        dirLight.castShadow = true;
        dirLight.shadow.mapSize.width = 2048;
        scene.add(dirLight);
        flashlightLight = new THREE.SpotLight(0xffeedd, 1.8, 35, Math.PI/5, 0.6);
        flashlightLight.position.set(0,1.6,0);
        flashlightLight.target = camera;
        scene.add(flashlightLight);
        
        postFX = setupPost();
        updateChunks();
        switchWeapon(1);
        for (let i=0;i<5;i++) spawnMonstersNearby();
        
        document.addEventListener('keydown', (e) => {
            const k = e.key.toLowerCase();
            if (k === 'w') keyState.w = true;
            if (k === 's') keyState.s = true;
            if (k === 'a') keyState.a = true;
            if (k === 'd') keyState.d = true;
            if (k === 'e') keyState.e = true;
            if (k === '1') switchWeapon(0);
            if (k === '2') switchWeapon(1);
            if (k === '3') switchWeapon(2);
            if (k === ' ' || k === 'f') shoot();
            if (k === 'v') meleeAttack();
        });
        document.addEventListener('keyup', (e) => {
            const k = e.key.toLowerCase();
            if (k === 'w') keyState.w = false;
            if (k === 's') keyState.s = false;
            if (k === 'a') keyState.a = false;
            if (k === 'd') keyState.d = false;
            if (k === 'e') keyState.e = false;
        });
        renderer.domElement.addEventListener('click', () => renderer.domElement.requestPointerLock());
        document.addEventListener('pointerlockchange', () => isPointerLock = document.pointerLockElement === renderer.domElement);
        document.addEventListener('mousemove', (e) => {
            if (isPointerLock) {
                cameraRotation.yaw -= e.movementX * 0.0022;
                cameraRotation.pitch -= e.movementY * 0.0022;
                cameraRotation.pitch = Math.max(-0.75, Math.min(0.65, cameraRotation.pitch));
            }
        });
        document.getElementById('shoot-btn').addEventListener('click', () => shoot());
        document.getElementById('melee-btn').addEventListener('click', () => meleeAttack());
        document.getElementById('flashlight-btn').addEventListener('click', () => {
            let on = flashlightLight.intensity > 0;
            flashlightLight.intensity = on ? 0 : 1.8;
            document.getElementById('flashlight-btn').innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.64 5.64l2.12 2.12M16.24 16.24l2.12 2.12M16.24 7.76l2.12-2.12M5.64 18.36l2.12-2.12"/><circle cx="12" cy="12" r="3"/></svg>手电 ${on ? 'OFF' : 'ON'}`;
        });
        rescueBtn.addEventListener('click', () => {
            if (isDead) return;
            if (almondWater <= 0) return;
            for (let [id, p] of players) {
                if (p.isDead && camera.position.distanceTo(new THREE.Vector3(p.deathPos.x, 0, p.deathPos.z)) < 5) {
                    supabase.from('players').update({ is_dead: false }).eq('user_id', id);
                    almondWater--;
                    updateUI();
                    break;
                }
            }
        });
        
        const joyArea = document.getElementById('joystick-area');
        const thumb = document.getElementById('joystick-thumb');
        let joyCenter = { x:0, y:0 };
        joyArea.addEventListener('touchstart', (e) => {
            e.preventDefault();
            const rect = joyArea.getBoundingClientRect();
            joyCenter = { x: rect.left+rect.width/2, y: rect.top+rect.height/2 };
            joystickActive = true;
        });
        joyArea.addEventListener('touchmove', (e) => {
            e.preventDefault();
            const touch = e.touches[0];
            const dx = touch.clientX - joyCenter.x;
            const dy = touch.clientY - joyCenter.y;
            const len = Math.min(45, Math.hypot(dx,dy));
            const angle = Math.atan2(dy,dx);
            const tx = Math.cos(angle)*len, ty = Math.sin(angle)*len;
            thumb.style.transform = `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px))`;
            joystickVector.x = tx/45;
            joystickVector.z = ty/45;
        });
        joyArea.addEventListener('touchend', () => {
            joystickActive = false;
            joystickVector = { x:0, z:0 };
            thumb.style.transform = 'translate(-50%, -50%)';
        });
        
        let lastSync = 0;
        function animate() {
            requestAnimationFrame(animate);
            const delta = Math.min(0.033, clock.getDelta());
            updateMovement(delta);
            updateChunks();
            for (let m of monsters) m.update(delta, camera.position);
            spawnMonstersNearby();
            handleInteractions();
            updateStats(delta);
            const now = Date.now();
            if (now - lastSync > 150) { syncPlayers(); lastSync = now; }
            renderer.setRenderTarget(postFX.renderTarget);
            renderer.render(scene, camera);
            renderer.setRenderTarget(null);
            postFX.material.uniforms.uTime.value = now / 1000;
            renderer.render(postFX.scene, postFX.camera);
        }
        animate();
        
        document.getElementById('loading').style.display = 'none';
        document.getElementById('ui').style.display = 'block';
    }
    
    async function handleAuth(event) {
        const email = document.getElementById('auth-email').value;
        const pwd = document.getElementById('auth-password').value;
        const msg = document.getElementById('auth-msg');
        if (!email || !pwd) { msg.innerText = '请输入邮箱和密码'; return; }
        if (event.target.id === 'register-btn') {
            const { error } = await supabase.auth.signUp({ email, password: pwd });
            if (error) msg.innerText = error.message;
            else msg.innerText = '注册成功，请登录';
        } else {
            const { data, error } = await supabase.auth.signInWithPassword({ email, password: pwd });
            if (error) msg.innerText = error.message;
            else {
                currentUser = data.user;
                document.getElementById('auth-panel').style.display = 'none';
                initGame();
            }
        }
    }
    document.getElementById('login-btn').addEventListener('click', handleAuth);
    document.getElementById('register-btn').addEventListener('click', handleAuth);
    document.getElementById('auth-panel').style.display = 'block';
    document.getElementById('loading').style.display = 'none';
</script>
</body>
