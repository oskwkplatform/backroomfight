    // ==================== 地图生成（真实感纹理） ====================
    const CHUNK_SIZE = 100;
    function createRealTexture(type) {
        const canvas = document.createElement('canvas'); canvas.width = 2048; canvas.height = 2048;
        const ctx = canvas.getContext('2d');
        if (type === 'wall') {
            ctx.fillStyle = '#c8b28b'; ctx.fillRect(0,0,canvas.width,canvas.height);
            for(let i=0;i<15000;i++){ ctx.fillStyle = `rgba(80,70,50,${Math.random()*0.3})`; ctx.fillRect(Math.random()*canvas.width, Math.random()*canvas.height, 3,3); }
            ctx.strokeStyle = '#aa8a5a'; ctx.lineWidth = 6;
            for(let i=0;i<60;i++){ ctx.beginPath(); ctx.moveTo(Math.random()*canvas.width, Math.random()*canvas.height); ctx.lineTo(Math.random()*canvas.width, Math.random()*canvas.height); ctx.stroke(); }
        } else if (type === 'floor') {
            ctx.fillStyle = '#a87b45'; ctx.fillRect(0,0,canvas.width,canvas.height);
            for(let i=0;i<8000;i++){ ctx.fillStyle = `rgba(70,50,30,${Math.random()*0.25})`; ctx.fillRect(Math.random()*canvas.width, Math.random()*canvas.height, 4,4); }
            ctx.strokeStyle = '#8a623a'; ctx.lineWidth = 3;
            const step = 256;
            for(let x=0;x<canvas.width;x+=step){ ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,canvas.height); ctx.stroke(); }
            for(let y=0;y<canvas.height;y+=step){ ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(canvas.width,y); ctx.stroke(); }
        } else {
            ctx.fillStyle = '#cfb284'; ctx.fillRect(0,0,canvas.width,canvas.height);
            for(let i=0;i<5000;i++){ ctx.fillStyle = `rgba(100,80,60,${Math.random()*0.2})`; ctx.fillRect(Math.random()*canvas.width, Math.random()*canvas.height, 2,2); }
        }
        const tex = new THREE.CanvasTexture(canvas);
        tex.wrapS = THREE.RepeatWrapping; tex.wrapT = THREE.RepeatWrapping;
        tex.repeat.set(4,4);
        return tex;
    }
    function generateChunk(cx, cz) {
        const group = new THREE.Group();
        const startX = cx * CHUNK_SIZE, startZ = cz * CHUNK_SIZE;
        const cell = 10, grid = 10;
        const wallMat = new THREE.MeshStandardMaterial({ map: createRealTexture('wall'), roughness: 0.65 });
        const floorMat = new THREE.MeshStandardMaterial({ map: createRealTexture('floor'), roughness: 0.8 });
        const ceilMat = new THREE.MeshStandardMaterial({ map: createRealTexture('ceil'), roughness: 0.7 });
        for (let i = 0; i < grid; i++) {
            for (let j = 0; j < grid; j++) {
                const x = startX + i * cell, z = startZ + j * cell;
                const isWall = (Math.sin(i * 0.9) + Math.cos(j * 1.2)) > 0.55 && (i !== 0 && i !== grid-1 && j !== 0 && j !== grid-1);
                if (i === 0 || i === grid-1 || j === 0 || j === grid-1 || isWall) {
                    const wall = new THREE.Mesh(new THREE.BoxGeometry(cell, 4.0, 0.4), wallMat);
                    wall.position.set(x + cell/2, 2.0, z + cell/2); group.add(wall);
                }
                const floor = new THREE.Mesh(new THREE.PlaneGeometry(cell, cell), floorMat);
                floor.rotation.x = -Math.PI/2; floor.position.set(x + cell/2, 0, z + cell/2); group.add(floor);
                const ceil = new THREE.Mesh(new THREE.PlaneGeometry(cell, cell), ceilMat);
                ceil.rotation.x = Math.PI/2; ceil.position.set(x + cell/2, 4.0, z + cell/2); group.add(ceil);
                if ((i+j) % 2 === 0) {
                    const light = new THREE.PointLight(0xffdd99, 1.0, 25);
                    light.position.set(x + cell/2, 3.4, z + cell/2);
                    light.castShadow = true;
                    group.add(light);
                }
            }
        }
        return group;
    }
    let loadedChunks = new Map();
    function updateChunks() {
        const pcx = Math.floor(camera.position.x / CHUNK_SIZE);
        const pcz = Math.floor(camera.position.z / CHUNK_SIZE);
        for (let dx = -2; dx <= 2; dx++) {
            for (let dz = -2; dz <= 2; dz++) {
                const cx = pcx + dx, cz = pcz + dz;
                const key = `${cx},${cz}`;
                if (!loadedChunks.has(key)) {
                    const chunk = generateChunk(cx, cz);
                    scene.add(chunk);
                    loadedChunks.set(key, chunk);
                }
            }
        }
        for (let [key, group] of loadedChunks) {
            const [cx, cz] = key.split(',').map(Number);
            if (Math.abs(cx - pcx) > 3 || Math.abs(cz - pcz) > 3) {
                scene.remove(group);
                loadedChunks.delete(key);
            }
        }
    }
    
